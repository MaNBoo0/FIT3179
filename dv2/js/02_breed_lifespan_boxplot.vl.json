{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Box plot with overlaid breed dots: the median lifespan of 154 dog breeds, one row per body size, coloured by face shape. The shaded box covers the middle half of the breeds in each size group and the dark line marks the middle breed (no whiskers, because the dots show the full range). Dots that share a lifespan are stacked so none hide each other. Each dot is a breed's median, not an individual dog. Poodle is excluded because the source gives it no size class. Data: McMillan et al. (2024), Scientific Reports.",
  "data": {
    "url": "../data/dog_breeds_lifespan.csv",
    "format": {
      "type": "csv",
      "parse": {
        "median_years": "number",
        "dogs": "number",
        "deaths": "number"
      }
    }
  },
  "params": [
    {
      "name": "search",
      "value": "",
      "bind": {
        "input": "search",
        "placeholder": "e.g. Labrador",
        "name": "Find a breed "
      }
    }
  ],
  "transform": [
    {
      "calculate": "datum.breed === 'Bulldog' ? 'British Bulldog' : datum.breed",
      "as": "breed"
    },
    {
      "filter": "datum.size !== 'NA'"
    },
    {
      "calculate": "floor(datum.median_years / 0.1)",
      "as": "lifespan_bin"
    },
    {
      "window": [
        {
          "op": "row_number",
          "as": "k"
        }
      ],
      "groupby": [
        "size",
        "lifespan_bin"
      ],
      "sort": [
        {
          "field": "median_years"
        },
        {
          "field": "breed"
        }
      ]
    },
    {
      "calculate": "datum.k % 2 === 1 ? (datum.k - 1) / 2 : -datum.k / 2",
      "as": "stack_offset"
    },
    {
      "calculate": "search !== '' && indexof(lower(datum.breed), lower(search)) >= 0",
      "as": "is_match"
    },
    {
      "calculate": "datum.breed === 'French Bulldog' || datum.breed === 'British Bulldog'",
      "as": "is_story"
    }
  ],
  "width": 1000,
  "height": 300,
  "encoding": {
    "x": {
      "field": "median_years",
      "type": "quantitative",
      "title": "Median lifespan (years)",
      "scale": {
        "domain": [
          5,
          16
        ]
      },
      "axis": {
        "tickCount": 11,
        "grid": true
      }
    },
    "y": {
      "field": "size",
      "type": "nominal",
      "sort": [
        "Small",
        "Medium",
        "Large"
      ],
      "title": null,
      "axis": {
        "ticks": false,
        "domain": false,
        "labelFontSize": 13,
        "labelFontWeight": 600,
        "labelColor": "#444444",
        "labelPadding": 8,
        "minExtent": 70
      }
    },
    "yOffset": {
      "field": "stack_offset",
      "type": "quantitative",
      "scale": {
        "domain": [
          -6,
          6
        ]
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "boxplot",
        "extent": 1.5,
        "size": 64,
        "outliers": false,
        "box": {
          "color": "#EDEDED",
          "stroke": "#D3D6E0",
          "strokeWidth": 1
        },
        "median": {
          "color": "#444444",
          "thickness": 2.5
        },
        "rule": {
          "color": "#8C8C8C",
          "strokeWidth": 1.5
        },
        "ticks": {
          "color": "#8C8C8C",
          "size": 18
        }
      },
      "encoding": {
        "yOffset": null
      }
    },
    {
      "transform": [
        {
          "aggregate": [
            {
              "op": "median",
              "field": "median_years",
              "as": "median_years"
            }
          ],
          "groupby": [
            "size"
          ]
        },
        {
          "calculate": "'middle ' + format(datum.median_years, '.1f')",
          "as": "mid_label"
        }
      ],
      "mark": {
        "type": "text",
        "baseline": "top",
        "dy": 36,
        "fontSize": 12,
        "fontWeight": 600,
        "color": "#444444"
      },
      "encoding": {
        "yOffset": null,
        "text": {
          "field": "mid_label"
        }
      }
    },
    {
      "transform": [
        {
          "aggregate": [
            {
              "op": "max",
              "field": "median_years",
              "as": "median_years"
            }
          ]
        }
      ],
      "mark": {
        "type": "rule",
        "color": "#6B6B6B",
        "strokeWidth": 1
      },
      "encoding": {
        "x": {
          "datum": 12.5
        },
        "y": null,
        "yOffset": null
      }
    },
    {
      "transform": [
        {
          "aggregate": [
            {
              "op": "max",
              "field": "median_years",
              "as": "median_years"
            }
          ]
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "top",
        "dx": 5,
        "fontSize": 13,
        "color": "#444444"
      },
      "encoding": {
        "x": {
          "datum": 12.5
        },
        "y": {
          "value": 2
        },
        "yOffset": null,
        "text": {
          "value": "All dogs: 12.5 years"
        }
      }
    },
    {
      "mark": {
        "type": "circle",
        "size": 55,
        "strokeWidth": 1,
        "cursor": "pointer"
      },
      "encoding": {
        "color": {
          "field": "face",
          "type": "nominal",
          "title": "Face shape",
          "scale": {
            "domain": [
              "Flat-faced",
              "Medium",
              "Long-nosed"
            ],
            "range": [
              "#5B5F97",
              "#C4C4C4",
              "#FFC145"
            ]
          },
          "legend": {
            "orient": "top",
            "direction": "horizontal",
            "symbolType": "circle",
            "symbolStrokeWidth": 0
          }
        },
        "opacity": {
          "condition": {
            "test": "search === '' || datum.is_match",
            "value": 1
          },
          "value": 0.15
        },
        "tooltip": [
          {
            "field": "breed",
            "title": "Breed"
          },
          {
            "field": "median_years",
            "title": "Median lifespan (years)"
          },
          {
            "field": "size",
            "title": "Body size"
          },
          {
            "field": "face",
            "title": "Face shape"
          },
          {
            "field": "dogs",
            "title": "Dogs in study",
            "format": ","
          }
        ],
        "stroke": {
          "condition": {
            "test": "datum.face === 'Long-nosed'",
            "value": "#B07D00"
          },
          "value": "#FFFFFF"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "(search === '' && datum.is_story) || datum.is_match"
        }
      ],
      "mark": {
        "type": "point",
        "shape": "circle",
        "filled": false,
        "size": 200,
        "stroke": "#1F1F1F",
        "strokeWidth": 1.5,
        "opacity": 1,
        "cursor": "pointer"
      },
      "encoding": {
        "tooltip": [
          {
            "field": "breed",
            "title": "Breed"
          },
          {
            "field": "median_years",
            "title": "Median lifespan (years)"
          },
          {
            "field": "size",
            "title": "Body size"
          },
          {
            "field": "face",
            "title": "Face shape"
          },
          {
            "field": "dogs",
            "title": "Dogs in study",
            "format": ","
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "search === '' && datum.is_story"
        },
        {
          "calculate": "datum.breed + ', ' + format(datum.median_years, '.1f') + ' years'",
          "as": "story_label"
        }
      ],
      "mark": {
        "type": "text",
        "dy": -14,
        "fontSize": 13,
        "color": "#1F1F1F"
      },
      "encoding": {
        "text": {
          "field": "story_label"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.is_match"
        }
      ],
      "mark": {
        "type": "text",
        "dy": -14,
        "fontSize": 13,
        "fontWeight": 600,
        "color": "#1F1F1F"
      },
      "encoding": {
        "text": {
          "field": "breed"
        }
      }
    }
  ]
}
